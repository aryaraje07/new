NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/
MONGO_DB_NAME=rozgarlink
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRY=7d
# Gemini is used for resume review and job matching.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional Gemini API base URL; defaults to the Google Generative Language API.
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# Grok is used only to generate job-tailored resume drafts.
GROK_API_KEY=
GROK_MODEL=grok-4.7
# Optional API base URL; defaults to https://api.x.ai/v1/responses
# GROK_API_URL=https://api.x.ai/v1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
